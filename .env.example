# Copy file này thành ".env" (không commit .env thật) rồi điền giá trị thật.

# Mật khẩu cho user "sa" của SQL Server container.
# Yêu cầu của SQL Server: >= 8 ký tự, có hoa/thường/số/ký tự đặc biệt.
DB_SA_PASSWORD=Your_strong_password123!

# JWT signing key, nên dùng chuỗi random mạnh, ví dụ tạo bằng:
#   openssl rand -base64 48
JWT_KEY=replace-with-a-strong-random-key
